{
  "manifest_version": 3,
  "name": "Prompt Optimizer",
  "version": "1.7.0",
  "description": "개인 Gemini API 키로 자연어 요청을 분석해 맞춤 프롬프트로 재작성합니다.",
  "minimum_chrome_version": "112",
  "permissions": [
    "storage",
    "activeTab"
  ],
  "background": {
    "service_worker": "background/background.js",
    "type": "module"
  },
  "action": {
    "default_popup": "popup/popup.html",
    "default_title": "Prompt Optimizer",
    "default_icon": {
      "16": "assets/icons/icon16.png",
      "32": "assets/icons/icon32.png",
      "48": "assets/icons/icon48.png",
      "128": "assets/icons/icon128.png"
    }
  },
  "icons": {
    "16": "assets/icons/icon16.png",
    "32": "assets/icons/icon32.png",
    "48": "assets/icons/icon48.png",
    "128": "assets/icons/icon128.png"
  },
  "content_scripts": [
    {
      "matches": [
        "https://chatgpt.com/*",
        "https://chat.openai.com/*"
      ],
      "js": [
        "content/chatgpt.js",
        "content/common.js"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://claude.ai/*"
      ],
      "js": [
        "content/claude.js",
        "content/common.js"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://gemini.google.com/*"
      ],
      "js": [
        "content/gemini.js",
        "content/common.js"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://perplexity.ai/*",
        "https://www.perplexity.ai/*"
      ],
      "js": [
        "content/perplexity.js",
        "content/common.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'none'; base-uri 'none'; connect-src https://generativelanguage.googleapis.com"
  },
  "options_ui": {
    "page": "options/options.html",
    "open_in_tab": true
  },
  "optional_host_permissions": [
    "https://generativelanguage.googleapis.com/*"
  ]
}
