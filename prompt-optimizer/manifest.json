{
  "manifest_version": 3,
  "name": "말결 — AI 프롬프트 최적화",
  "version": "1.13.1",
  "description": "내 뜻을 살리는 프롬프트. 개인 Gemini API 키로 요청의 의도와 조건을 분석하고 대상 AI 모델에 맞는 프롬프트로 다듬습니다.",
  "minimum_chrome_version": "112",
  "permissions": [
    "storage"
  ],
  "background": {
    "service_worker": "background/background.js",
    "type": "module"
  },
  "action": {
    "default_popup": "popup/popup.html",
    "default_title": "말결 — 내 뜻을 살리는 프롬프트",
    "default_icon": {
      "16": "assets/icons/icon16.png",
      "32": "assets/icons/icon32.png",
      "48": "assets/icons/icon48.png",
      "128": "assets/icons/icon128.png"
    }
  },
  "icons": {
    "16": "assets/icons/icon16.png",
    "32": "assets/icons/icon32.png",
    "48": "assets/icons/icon48.png",
    "128": "assets/icons/icon128.png"
  },
  "content_scripts": [
    {
      "matches": [
        "https://chatgpt.com/*",
        "https://chat.openai.com/*"
      ],
      "js": [
        "content/chatgpt.js",
        "content/common.js"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://claude.ai/*"
      ],
      "js": [
        "content/claude.js",
        "content/common.js"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://gemini.google.com/*"
      ],
      "js": [
        "content/gemini.js",
        "content/common.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'none'; base-uri 'none'; connect-src https://generativelanguage.googleapis.com https://hion89.github.io"
  },
  "options_ui": {
    "page": "options/options.html",
    "open_in_tab": true
  },
  "optional_host_permissions": [
    "https://generativelanguage.googleapis.com/*"
  ],
  "host_permissions": [
    "https://hion89.github.io/Prompt-helper/registry/*"
  ],
  "short_name": "말결"
}
